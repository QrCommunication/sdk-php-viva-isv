{
    "name": "qrcommunication/viva-isv-sdk",
    "description": "PHP SDK for Viva Wallet ISV Partner API — connected accounts, ISV orders, composite auth, Cloud Terminal",
    "type": "library",
    "license": "MIT",
    "keywords": ["viva", "vivawallet", "isv", "payment", "marketplace", "sdk"],
    "authors": [
        {
            "name": "QrCommunication",
            "email": "dev@praticonnect.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "QrCommunication\\VivaIsv\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QrCommunication\\VivaIsv\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
